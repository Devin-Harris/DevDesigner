# Server configuration. Copy to .env and adjust for local dev.

# HTTP
PORT=3000
# Comma-separated list of allowed CORS origins (the Angular dev server).
CORS_ORIGIN=http://localhost:4242

# Database (SQLite single-file, relative to the server working directory)
DATABASE_PATH=devdesigner.sqlite
# Auto-create/update the schema from entities (default on everywhere for now:
# there is no baseline migration, so production still relies on it).
DATABASE_SYNCHRONIZE=true
# Queries slower than this (ms) are logged at warn level. 0 disables.
SLOW_QUERY_MS=200

# Runtime mode. With NODE_ENV=production the server refuses to boot unless
# JWT_SECRET is set, at least 32 characters, and not the default below.
# NODE_ENV=production

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
# Set true in production (HTTPS) so the session cookie is only sent over TLS.
COOKIE_SECURE=false
# lax (default) | strict | none. Use none when the client and API are on different
# sites (e.g. two *.up.railway.app subdomains); it forces Secure on.
COOKIE_SAMESITE=lax

# Base URL used when building shareable links (/shared/:token)
PUBLIC_APP_URL=http://localhost:4242

# Requests per minute allowed per API token (MCP / bearer clients).
API_TOKEN_RATE_LIMIT=600

# Logging: fatal | error | warn | info | debug | trace | silent.
# Default: debug in dev (pretty-printed), info in production (JSON).
LOG_LEVEL=debug

# Error reporting (Sentry). Leave empty to disable entirely.
SENTRY_DSN=
# Fraction of requests traced for performance (0-1). 0 = errors only.
SENTRY_TRACES_SAMPLE_RATE=0
