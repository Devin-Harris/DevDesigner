# Server configuration. Copy to .env and adjust for local dev.

# HTTP
PORT=3000
# Comma-separated list of allowed CORS origins (the Angular dev server).
CORS_ORIGIN=http://localhost:4242

# Database (SQLite single-file, relative to the server working directory)
DATABASE_PATH=devdesigner.sqlite
# Auto-create/update the schema from entities (default on everywhere for now:
# there is no baseline migration, so production still relies on it).
DATABASE_SYNCHRONIZE=true
# Queries slower than this (ms) are logged at warn level. 0 disables.
SLOW_QUERY_MS=200

# Runtime mode. With NODE_ENV=production the server refuses to boot unless
# JWT_SECRET is set, at least 32 characters, and not the default below.
# NODE_ENV=production

# Auth
JWT_SECRET=change-me-in-production
# Session lifetime; the session cookie's maxAge follows it (e.g. 7d, 12h, or seconds).
JWT_EXPIRES_IN=7d
# Set true in production (HTTPS) so the session cookie is only sent over TLS.
COOKIE_SECURE=false
# lax (default) | strict | none. Use none when the client and API are on different
# sites (e.g. two *.up.railway.app subdomains); it forces Secure on.
COOKIE_SAMESITE=lax

# Base URL used when building shareable links (/shared/:token)
PUBLIC_APP_URL=http://localhost:4242
# Optional. Share tokens are stored hashed, plus sealed (AES-GCM) so owners can copy
# old links again. Empty = the seal key is derived from JWT_SECRET. If the secret in
# use changes, existing links keep working but the share dialog cannot show their URL.
SHARE_TOKEN_SECRET=

# Comma-separated emails (case-insensitive) promoted to admin on boot and on
# login/register. Promotion only: removing an email does not demote (users.role is
# authoritative; demote with SQL). Empty = no admins.
ADMIN_EMAILS=

# Requests per minute allowed per API token (MCP / bearer clients).
API_TOKEN_RATE_LIMIT=600

# Logging: fatal | error | warn | info | debug | trace | silent.
# Default: debug in dev (pretty-printed), info in production (JSON).
LOG_LEVEL=debug

# Error reporting (Sentry). Leave empty to disable entirely.
SENTRY_DSN=
# Fraction of requests traced for performance (0-1). 0 = errors only.
SENTRY_TRACES_SAMPLE_RATE=0

# --- Rate limiting (security S3.1) ---
# Reverse-proxy hops in front of the server (Railway: 1). 0 = trust none (req.ip is the socket).
TRUST_PROXY_HOPS=1
# false turns all HTTP rate limits off (load tests only).
RATE_LIMIT_ENABLED=true
# Requests per minute per caller (account, API token, guest id or IP) across all routes.
RATE_LIMIT_PER_MIN=1200
# Requests per minute per client IP across all routes (stops guest-id rotation).
RATE_LIMIT_IP_PER_MIN=3000

# --- Storage quotas (security S3.2). 0 = unlimited. ---
QUOTA_PROJECTS_PER_OWNER=500
QUOTA_TABLES_PER_PROJECT=5000
QUOTA_ELEMENTS_PER_PROJECT=20000
# 1 GiB
QUOTA_IMAGE_BYTES_PER_OWNER=1073741824
# 512 MiB
QUOTA_IMAGE_BYTES_PER_PROJECT=536870912
QUOTA_IMPORT_MAX_IMAGES=1000

# --- Caches (perf P3.3 / P3.4) ---
# Lifetime (ms) of access-cache entries (project owner, share link). 0 = no cache.
ACCESS_CACHE_TTL_MS=30000
# Bytes of serialized project graphs kept in memory (64 MiB). 0 = no graph cache.
GRAPH_CACHE_MAX_BYTES=67108864

# --- Realtime (perf P3.1) ---
# Broadcast batch edits as *.patched (changed fields only; the client merges them). false = full *.updated.
REALTIME_PATCH_MUTATIONS=true

# --- Media storage (perf P4.5) ---
# Only "fs" for now.
MEDIA_DRIVER=fs
# Folder for uploaded media; empty = a "media" folder next to DATABASE_PATH.
MEDIA_DIR=

# --- Analytics (audit 04 Phase 1) ---
# First-party event capture into a separate SQLite file. false = no capture at all
# (no analytics file is opened, no activity columns are touched).
ANALYTICS_ENABLED=true
# Empty = analytics.sqlite next to DATABASE_PATH (on Railway: the same volume).
ANALYTICS_DATABASE_PATH=
# Keys the daily IP hash and the guest-id / share-token hashes. Set a long random
# value in production; empty = random per process (hashed ids change on restart).
ANALYTICS_SALT_SECRET=
# Fraction (0-1) of fast, successful browser GETs recorded as api.request.
# Writes, errors, slow requests and API-token / MCP calls are always recorded.
ANALYTICS_GET_SAMPLE=0.05
# Requests at least this slow (ms) are always recorded.
SLOW_REQUEST_MS=1000
# Raw analytics events older than this many days are purged daily. 0 = keep forever.
ANALYTICS_RAW_RETENTION_DAYS=90

# --- OAuth sign-in (optional) ---
# Public URL of the API including /api; providers redirect to
# <PUBLIC_API_URL>/auth/oauth/<google|github>/callback (register that exact URL).
# After sign-in the browser returns to PUBLIC_APP_URL. Ignored in desktop mode.
PUBLIC_API_URL=http://localhost:3000/api
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
