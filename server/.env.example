# Server configuration. Copy to .env and adjust for local dev.

# HTTP
PORT=3000
# Comma-separated list of allowed CORS origins (the Angular dev server).
CORS_ORIGIN=http://localhost:4242

# Database (SQLite single-file, relative to the server working directory)
DATABASE_PATH=dbdesigner.sqlite
# Auto-create/update the schema from entities. Handy for local dev (default on);
# set to false and use migrations before any real deployment.
DATABASE_SYNCHRONIZE=true

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
# Set true in production (HTTPS) so the session cookie is only sent over TLS.
COOKIE_SECURE=false
# lax (default) | strict | none. Use none when the client and API are on different
# sites (e.g. two *.up.railway.app subdomains); it forces Secure on.
COOKIE_SAMESITE=lax

# Base URL used when building shareable links (/shared/:token)
PUBLIC_APP_URL=http://localhost:4242
