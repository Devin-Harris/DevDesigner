#!/bin/sh
# Runs the same gate as CI (`npm run verify`) before anything is pushed to main.
# Skip once with: git push --no-verify
pushes_main=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] && pushes_main=1
done
[ "$pushes_main" = 1 ] || exit 0

echo "pre-push: running npm run verify (CI gate) before pushing to main..."
if ! npm run verify; then
  echo ""
  echo "pre-push: npm run verify FAILED - this push would fail CI. Fix it, or bypass with --no-verify."
  exit 1
fi
