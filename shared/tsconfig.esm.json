{
  // ES module build for the client bundler (dist/esm). The default build
  // (tsconfig.json, dist/) stays CommonJS for the server and the MCP.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "bundler",
    "outDir": "dist/esm",
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false
  }
}
