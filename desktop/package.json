{
  "name": "@devdesigner/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "DevDesigner desktop app (Electron shell around the local server + client).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "test": "jest --passWithNoTests",
    "stage": "node scripts/stage.mjs",
    "dist": "node scripts/stage.mjs && electron-builder --publish never",
    "release": "node scripts/stage.mjs && electron-builder --publish always"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "electron": "42.11.18",
    "electron-builder": "^26.18.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src"
  },
  "productName": "DevDesigner",
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
